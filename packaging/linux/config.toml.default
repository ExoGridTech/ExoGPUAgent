# ExoGPUAgent machine configuration (localhost only).
# Copied to /etc/exogpuagent/config.toml on first install if absent.
# Upgrades must not overwrite an existing config.toml.

host_name = ""
bind = "127.0.0.1"
port = 12001
access_mode = "localhost"
autostart = true

# Mini GUI (Phase 2C-C2) — disabled by default; never auto-enabled on upgrade.
# Bootstrap: exogpuagent gui init --machine --password-stdin
# Then:     exogpuagent config set --machine gui.enabled=true && systemctl restart exogpuagent
[gui]
enabled = false
bind = "127.0.0.1"
port = 12010
poll_interval_secs = 5
