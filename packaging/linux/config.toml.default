# ExoGPUAgent machine configuration (localhost only).
# Copied to /etc/exogpuagent/config.toml on first install if absent.
# Upgrades must not overwrite an existing config.toml.

host_name = ""
bind = "127.0.0.1"
port = 12001
access_mode = "localhost"
autostart = true

# Mini GUI (Phase 2C-C2) — disabled by default; never auto-enabled on upgrade.
# Enable interactively (recommended):  sudo exogpuagent gui setup
# Non-interactive: printf '%s\n' 'secret' | sudo exogpuagent gui init --password-stdin
#   && sudo exogpuagent config set --machine gui.enabled=true && sudo systemctl restart exogpuagent
[gui]
enabled = false
bind = "127.0.0.1"
port = 12010
poll_interval_secs = 5
